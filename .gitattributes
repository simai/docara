# Development-only paths stay out of `git archive`, the tree Composer
# downloads for a tag.
/.editorconfig export-ignore
/.gitattributes export-ignore
/.github export-ignore
/.gitignore export-ignore
/.markdownlint.json export-ignore
/CONTRIBUTING.md export-ignore
/phpunit.xml export-ignore
/pint.json export-ignore
/tests export-ignore
/docs/site/.gitignore export-ignore

# Framework bytes are kept exactly as the pinned release ships them.
resources/framework/runtime-lock.json -text
resources/framework/manifests/*.json -text
resources/framework/assets/** -text
resources/framework/runtime-smart/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
resources/framework/composition-runtime/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
resources/portable/vendor/simai-framework/runtime/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
