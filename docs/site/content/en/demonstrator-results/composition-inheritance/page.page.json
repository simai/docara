{
  "schema": "docara.page.v1",
  "title": "Cancel a payment",
  "description": "Demo page: site, section and page settings add up.",
  "layout": {
    "regions": {
      "outline": {
        "$reset": true,
        "enabled": true,
        "sections": [
          {"id": "page-outline", "section": "docara.outline"},
          {
            "id": "page-context",
            "section": "docara.shell",
            "utilities": ["flex", "flex-col", "gap-1"],
            "blocks": [
              {"id": "label", "block": "shell.element", "slot": "content", "element": {"tag": "p", "text": "Updated on 2 November 2026.", "utilities": ["m-0"]}}
            ]
          }
        ]
      },
      "footer": {
        "enabled": true,
        "sections": [
          {
            "id": "page-footer",
            "section": "docara.shell",
            "utilities": ["flex", "flex-col", "gap-1"],
            "blocks": [
              {"id": "label", "block": "shell.element", "slot": "content", "element": {"tag": "p", "text": "Questions about canceling? Contact Acme Pay support.", "utilities": ["m-0"]}}
            ]
          }
        ]
      }
    }
  }
}
