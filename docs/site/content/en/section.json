{
  "schema": "docara.section.v1",
  "title": "Docara documentation",
  "preset": "docs",
  "layout": {
    "container": {
      "max": 7
    },
    "regions": {
      "footer": {
        "enabled": true,
        "sections": [
          {
            "id": "site-footer",
            "section": "docara.shell",
            "utilities": [
              "flex",
              "flex-wrap",
              "items-center",
              "content-main-between",
              "gap-2"
            ],
            "blocks": [
              {
                "id": "copyright",
                "block": "shell.element",
                "slot": "content",
                "element": {
                  "tag": "p",
                  "text": "Docara documentation · © 2026 SIMAI",
                  "utilities": [
                    "m-0"
                  ]
                }
              },
              {
                "id": "made-with",
                "block": "shell.element",
                "slot": "content",
                "element": {
                  "tag": "a",
                  "text": "Made with Docara",
                  "href": "/en/start/what-is-docara/",
                  "aria_label": "What Docara is"
                }
              }
            ]
          }
        ]
      }
    }
  },
  "header_navigation": {
    "enabled": true,
    "repository": "https://github.com/simai/docara",
    "items": [
      {
        "id": "home",
        "label": "Home",
        "href": "/en/"
      },
      {
        "id": "guide",
        "label": "Guide",
        "href": "/en/start/",
        "sections": [
          "/en/start/",
          "/en/authoring/",
          "/en/settings/",
          "/en/build/"
        ]
      },
      {
        "id": "components",
        "label": "Components",
        "href": "/en/components/"
      }
    ]
  }
}
