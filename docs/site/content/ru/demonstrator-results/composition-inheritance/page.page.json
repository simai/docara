{
  "schema": "docara.page.v1",
  "title": "Отмена платежа",
  "description": "Демонстрационная страница: настройки сайта, раздела и страницы складываются вместе.",
  "layout": {
    "regions": {
      "outline": {
        "$reset": true,
        "enabled": true,
        "sections": [
          {"id": "page-outline", "section": "docara.outline"},
          {
            "id": "page-context",
            "section": "docara.shell",
            "utilities": ["flex", "flex-col", "gap-1"],
            "blocks": [
              {"id": "label", "block": "shell.element", "slot": "content", "element": {"tag": "p", "text": "Обновлено 2 ноября 2026 года.", "utilities": ["m-0"]}}
            ]
          }
        ]
      },
      "footer": {
        "enabled": true,
        "sections": [
          {
            "id": "page-footer",
            "section": "docara.shell",
            "utilities": ["flex", "flex-col", "gap-1"],
            "blocks": [
              {"id": "label", "block": "shell.element", "slot": "content", "element": {"tag": "p", "text": "Вопрос по отмене? Напишите в поддержку Acme Pay.", "utilities": ["m-0"]}}
            ]
          }
        ]
      }
    }
  }
}
