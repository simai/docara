{
  "schema": "docara.site.v1",
  "title": "Docara",
  "preset": "docs",
  "content_root": "content/en",
  "framework_lock": "simai-framework.lock.json",
  "smart": {
    "namespace": "project"
  },
  "default_locale": "en",
  "translation_tracking": {
    "enabled": true,
    "source_locale": "ru",
    "mode": "report",
    "lock_file": "translations.lock.json"
  },
  "locales": {
    "missing_page_policy": "skip",
    "en": {
      "label": "English",
      "direction": "ltr",
      "content_root": "content/en",
      "public_prefix": "en",
      "fallbacks": []
    },
    "ru": {
      "label": "Русский",
      "direction": "ltr",
      "content_root": "content/ru",
      "public_prefix": "ru",
      "fallbacks": []
    }
  },
  "locale_routing": {
    "strategy": "prefixed",
    "root": "redirect",
    "detect_browser_language": false,
    "legacy_unprefixed_redirects": true
  },
  "documentation_version": "current",
  "redirects_file": "redirects.json",
  "base_url": "/",
  "branding": {
    "title": "Docara",
    "mode": "logo",
    "size": "small",
    "logo": "assets/docara-logo.svg",
    "logo_dark": "assets/docara-logo-dark.svg",
    "logo_icon": "assets/docara-icon.svg",
    "favicon": "assets/docara-icon.svg",
    "share_image": "assets/share-en.png"
  },
  "layout": {
    "key": "docara.docs",
    "container": {"max": 7},
    "scrollbar": {"preset": "overlay"},
    "content": {"gap": 0}
  },
  "theme": {
    "choices": [
      {"id": "forest", "color": "#2e7d32", "title": {"ru": "Лес", "en": "Forest"}},
      {"id": "brick", "color": "#c62828", "title": {"ru": "Кирпич", "en": "Brick"}},
      {"id": "plum", "color": "#6a1b9a", "title": {"ru": "Слива", "en": "Plum"}}
    ]
  },
  "settings": {
    "theme": "system",
    "modal_blur": "none",
    "ui_radius": "default"
  },
  "reader_preferences": {
    "enabled": true,
    "view": "menu",
    "groups": [
      {
        "id": "appearance",
        "fields": ["appearance.theme", "appearance.color", "appearance.font_size", "appearance.content_width", "appearance.density"]
      }
    ]
  },
  "search": {
    "enabled": true,
    "indexed": true
  },
  "reading": {
    "breadcrumbs": true,
    "toc": true,
    "toc_depth": 3,
    "previous_next": true
  },
  "effects": {
    "catalogue": "https://cdn.jsdelivr.net/gh/simai/ui-effects@ffc71ca14ee8ed689f1e4dbfc8a6f221ebe1b140/"
  }
}
