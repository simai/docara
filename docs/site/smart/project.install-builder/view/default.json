{
  "schemaVersion": "1.0",
  "kind": "smart.view",
  "smart": "project.install-builder",
  "code": "default",
  "template": "default",
  "props": {},
  "children": {
    "operating-system": {
      "smart": "ui.dropdown",
      "slot": "controls",
      "preset": "default",
      "props": {"label": "Operating system", "name": "operating-system", "placeholder": "Choose an OS", "ariaLabel": "Operating system", "search": false},
      "children": {
        "macos": {"smart": "ui.list-item", "slot": "options", "preset": "default", "props": {"type": "text", "text": "macOS", "selected": true}},
        "linux": {"smart": "ui.list-item", "slot": "options", "preset": "default", "props": {"type": "text", "text": "Linux"}},
        "windows": {"smart": "ui.list-item", "slot": "options", "preset": "default", "props": {"type": "text", "text": "Windows PowerShell"}}
      }
    },
    "method": {
      "smart": "ui.dropdown",
      "slot": "controls",
      "preset": "default",
      "props": {"label": "How to run Composer", "name": "install-method", "placeholder": "Choose a method", "ariaLabel": "How to run Composer", "search": false},
      "children": {
        "composer": {"smart": "ui.list-item", "slot": "options", "preset": "default", "props": {"type": "text", "text": "Composer", "selected": true}},
        "phar": {"smart": "ui.list-item", "slot": "options", "preset": "default", "props": {"type": "text", "text": "Composer PHAR"}}
      }
    },
    "package": {
      "smart": "ui.input",
      "slot": "controls",
      "preset": "default",
      "props": {"label": "Composer package", "name": "package", "value": "simai/docara", "hint": "Format: vendor/package"}
    },
    "version": {
      "smart": "ui.input",
      "slot": "controls",
      "preset": "default",
      "props": {"label": "Version", "name": "version", "value": "^3.0", "hint": "For example ^3.0"}
    },
    "development": {
      "smart": "ui.checkbox",
      "slot": "controls",
      "preset": "default",
      "props": {"label": "Add as a development dependency (--dev)", "name": "development", "value": "--dev"}
    },
    "prefer-dist": {
      "smart": "ui.checkbox",
      "slot": "controls",
      "preset": "default",
      "props": {"label": "Prefer a prebuilt archive (--prefer-dist)", "name": "prefer-dist", "value": "--prefer-dist"}
    }
  }
}
