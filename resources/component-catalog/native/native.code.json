{
    "id": "native.code",
    "family": "native_markdown",
    "category": "technical_content",
    "lifecycle": "supported",
    "authoring": {
        "syntax": "markdown",
        "call": "```language {options}",
        "jobs": [
            "show_code"
        ],
        "parameters": [
            {
                "name": "title",
                "type": "string",
                "required": false
            },
            {
                "name": "highlight",
                "type": "string",
                "required": false,
                "validation": {
                    "pattern": "^[1-9][0-9]*(?:-[1-9][0-9]*)?(?:,[1-9][0-9]*(?:-[1-9][0-9]*)?)*$"
                }
            },
            {
                "name": "numbers",
                "type": "string",
                "required": false,
                "default": "false",
                "validation": {
                    "pattern": "^(?:true|false|[1-9][0-9]{0,5})$"
                }
            },
            {
                "name": "focus",
                "type": "string",
                "required": false,
                "validation": {
                    "pattern": "^[1-9][0-9]*(?:-[1-9][0-9]*)?(?:,[1-9][0-9]*(?:-[1-9][0-9]*)?)*$"
                }
            },
            {
                "name": "layout",
                "type": "enum",
                "required": false,
                "values": [
                    "default",
                    "terminal"
                ],
                "default": "default"
            }
        ]
    },
    "states": [],
    "verification": {
        "renderer": true,
        "tests": true,
        "docs": true,
        "demo": true
    },
    "docs_ref": "docs/site/content/ru/components/code.md",
    "provenance": {
        "source_kind": "portable_markdown_profile",
        "profile_id": "docara.portable_markdown_profile.v1"
    }
}
