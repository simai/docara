{
    "id": "native.links_and_images",
    "family": "native_markdown",
    "category": "prose",
    "lifecycle": "supported",
    "authoring": {
        "syntax": "markdown",
        "call": "[label](url) and ![alt](url)",
        "jobs": [
            "link_content",
            "illustrate_content"
        ],
        "parameters": [
            {"name": "ratio", "type": "enum", "required": false, "default": "auto", "values": ["auto", "1x1", "4x3", "3x2", "16x9", "21x9"]},
            {"name": "fit", "type": "enum", "required": false, "default": "cover", "values": ["cover", "contain"]}
        ]
    },
    "states": [
        "link_focus"
    ],
    "verification": {
        "renderer": true,
        "tests": true,
        "docs": true,
        "demo": true
    },
    "docs_ref": "docs/site/content/ru/authoring/markdown.md",
    "provenance": {
        "source_kind": "portable_markdown_profile",
        "profile_id": "docara.portable_markdown_profile.v1"
    }
}
