{
    "id": "docara.hero",
    "name": "hero",
    "renderer": "docara.hero.v1",
    "family": "docara_typed",
    "category": "landing",
    "lifecycle": "supported",
    "authoring": {
        "syntax": "directive",
        "call": ":::hero",
        "jobs": [
            "explain_product_value",
            "primary_landing_action"
        ],
    "parameters": [
      {"name": "layout", "type": "enum", "required": false, "default": "split", "values": ["split", "centered", "compact"], "deprecated_names": ["variant"]},
      {"name": "padding", "type": "enum", "required": false, "values": ["lg", "xl", "2xl"]},
      {"name": "media", "type": "enum", "required": false, "default": "auto", "values": ["auto", "side", "background", "none"]},
      {"name": "background_fit", "type": "enum", "required": false, "default": "cover", "values": ["cover", "contain", "auto"], "available_when": {"media": "background"}},
      {"name": "background_x", "type": "enum", "required": false, "default": "center", "values": ["left", "center", "right"], "available_when": {"media": "background"}},
      {"name": "background_y", "type": "enum", "required": false, "default": "center", "values": ["top", "center", "bottom"], "available_when": {"media": "background"}},
      {"name": "overlay", "type": "enum", "required": false, "default": "dark", "values": ["light", "dark"], "available_when": {"media": "background"}},
      {"name": "overlay_strength", "type": "enum", "required": false, "default": "medium", "values": ["soft", "medium", "strong"], "available_when": {"media": "background"}},
      {"name": "effect", "type": "string", "required": false},
      {"name": "effect_theme", "type": "enum", "required": false, "default": "auto", "values": ["auto", "dark", "light"]},
      {"name": "effect_settings", "type": "string", "required": false}
    ]
    },
    "states": [
        "text",
        "text_with_action",
        "text_with_media",
        "side_media",
        "background_media",
        "no_media"
    ],
    "verification": {
        "renderer": true,
        "tests": true,
        "docs": true,
        "demo": true
    },
    "docs_ref": "docs/site/content/ru/components/hero.md",
    "provenance": {
        "source_kind": "typed_definition",
        "definition_ref": "resources/component-catalog/typed/docara.hero.json"
    }
}
