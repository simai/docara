{
    "schema": "docara.content_component.v1",
    "id": "docara.button",
    "aliases": ["button"],
    "props": {
        "href": {"kind": "safe_url", "default": "", "required": true},
        "type": {"default": "default", "enum": ["default", "tonal", "outline", "link"]},
        "scheme": {"default": "primary", "enum": ["primary", "secondary", "on-surface"]},
        "size": {"default": "1", "enum": ["1/2", "1", "2"]},
        "icon": {"kind": "identifier", "default": ""}
    },
    "slots": {"default": {"required": true, "kind": "plain_text"}},
    "renderer": "docara.content.template",
    "template": "templates/button.php",
    "assets": []
}
