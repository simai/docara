{
  "schemaVersion": "1.0",
  "kind": "smart",
  "code": "ui.list-item",
  "title": "Simai Framework List Item",
  "description": "Portable selectable option item for admitted list and dropdown compositions.",
  "family": "input",
  "category": "form",
  "render": {
    "mode": "server-first",
    "strategy": "client-owned",
    "template": "default",
    "hydration": "required",
    "domStrategy": "host-attributes",
    "updateStrategy": "rerender",
    "initialHtml": "host-only",
    "frontendOwnership": "dom"
  },
  "props": {
    "templateName": {"type": "string", "default": "default"},
    "type": {"type": "enum", "values": ["text", "icon", "checkbox", "avatar", "color"], "default": "text"},
    "size": {"type": "enum", "values": ["1/3", "1/2", "1", "2", "3"], "default": "1"},
    "text": {"type": "string", "default": ""},
    "icon": {"type": "string", "default": "person"},
    "checked": {"type": "boolean", "default": false},
    "selected": {"type": "boolean", "default": false},
    "disabled": {"type": "boolean", "default": false},
    "colorClass": {"type": "string", "default": "bg-tertiary"},
    "avatarImageUrl": {"type": "string", "default": ""},
    "avatarTitle": {"type": "string", "default": ""},
    "ariaLabel": {"type": "string", "default": ""}
  },
  "slots": {
    "leading": {"required": false, "multiple": false},
    "text": {"required": false, "multiple": false},
    "trailing": {"required": false, "multiple": false}
  },
  "assets": {
    "css": [],
    "js": [],
    "depends": ["simai.ui", "simai.ui.smart"]
  },
  "cache": {"fragment": true, "tags": ["smart:ui.list-item"], "varyBy": ["props", "design", "locale"]},
  "ai": {
    "useWhen": "Use as an admitted selectable option inside a compatible list or dropdown slot.",
    "avoidWhen": "Do not use as a standalone form control or as a raw-markup escape hatch.",
    "composeWith": ["ui.dropdown"],
    "tags": ["form", "list", "option"]
  },
  "meta": {
    "owner": "Simai Framework",
    "sourceComponent": "list-item",
    "sourceRevision": "f615583112c16d05ba75dbc7e0f99eadd4c4d9d9",
    "sourcePath": "src/smart/list-item",
    "sourceRelations": ["dropdown", "icons", "checkbox", "avatars", "tags"],
    "admittedParent": "ui.dropdown"
  }
}
