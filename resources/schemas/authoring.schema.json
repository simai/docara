{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docara.local/schemas/authoring.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "docara.authoring.v1"},
    "audiences": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
    },
    "default_profile": {"$ref": "#/$defs/profile"},
    "infer_profiles": {"type": "boolean"},
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "glossary": {"type": "string", "pattern": "^/"},
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_.*?/-]+$"}
        }
      }
    },
    "templates": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/template"}
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["match"],
        "properties": {
          "match": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_.*?/-]+$"},
          "profile": {"$ref": "#/$defs/profile"},
          "template": {"$ref": "#/$defs/id"}
        }
      }
    }
  },
  "$defs": {
    "profile": {"enum": ["landing", "article", "tutorial", "how_to", "reference", "explanation"]},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "heading_text": {"type": "string", "minLength": 1, "pattern": "^[^\\n#]+$"},
    "heading": {
      "oneOf": [
        {"$ref": "#/$defs/heading_text"},
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
          "additionalProperties": {"$ref": "#/$defs/heading_text"}
        }
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "profile": {"$ref": "#/$defs/profile"},
        "other_sections": {"type": "boolean"},
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "heading"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "heading": {"$ref": "#/$defs/heading"},
              "required": {"type": "boolean"},
              "example": {"type": "boolean"},
              "example_per_subsection": {"type": "boolean"},
              "generated": {"type": "boolean"},
              "hint": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
