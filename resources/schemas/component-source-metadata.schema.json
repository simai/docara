{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://docara.simai.io/schemas/component-source-metadata.schema.json",
    "type": "object",
    "required": ["schema", "version", "repository", "revision", "entries", "content_sha256"],
    "properties": {
        "schema": {"const": "docara.component_source_metadata.v1"},
        "version": {"const": 1},
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "entries": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["source_ref", "source_sha256", "revision", "author", "changed_at", "history_exact"],
                "properties": {
                    "source_ref": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
                    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
                    "author": {"type": "string", "minLength": 1},
                    "changed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
                    "source_url": {"type": ["string", "null"]},
                    "history_url": {"type": ["string", "null"]},
                    "history_exact": {"type": "boolean"}
                },
                "additionalProperties": false
            }
        },
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "additionalProperties": false
}
