{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docara.local/schemas/scaffold-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_id", "kind", "id", "namespace", "input_hashes", "files"],
  "properties": {
    "schema": {"const": "docara.scaffold_plan.v1"},
    "plan_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "kind": {"enum": ["smart", "design"]},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9_-]*)+$"},
    "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^(?:absent|[a-f0-9]{64})$"}},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "content_base64"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?:smart|design)/[a-zA-Z0-9._/-]+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "content_base64": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
