{
  "schemaVersion": "1.0",
  "kind": "smart.view",
  "smart": "project.product-configurator",
  "code": "default",
  "template": "default",
  "props": {},
  "children": {
    "product": {
      "smart": "ui.dropdown",
      "slot": "controls",
      "preset": "default",
      "props": {"label": "Product plan", "name": "product", "placeholder": "Choose a plan", "ariaLabel": "Product plan"},
      "children": {
        "starter": {"smart": "ui.list-item", "slot": "options", "preset": "default", "props": {"type": "text", "text": "Starter", "selected": true}},
        "team": {"smart": "ui.list-item", "slot": "options", "preset": "default", "props": {"type": "text", "text": "Team"}},
        "business": {"smart": "ui.list-item", "slot": "options", "preset": "default", "props": {"type": "text", "text": "Business"}}
      }
    },
    "analytics": {"smart": "ui.checkbox", "slot": "controls", "preset": "default", "props": {"label": "Advanced analytics", "name": "features", "value": "1200"}},
    "teamwork": {"smart": "ui.checkbox", "slot": "controls", "preset": "default", "props": {"label": "Teamwork", "name": "features", "value": "800"}},
    "export": {"smart": "ui.checkbox", "slot": "controls", "preset": "default", "props": {"label": "Data export", "name": "features", "value": "500"}}
  }
}
