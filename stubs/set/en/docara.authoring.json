{
  "schema": "docara.authoring.v1",
  "infer_profiles": true,
  "rules": [
    {
      "match": "index.md",
      "profile": "landing"
    },
    {
      "match": "connection.md",
      "profile": "article"
    },
    {
      "match": "components/**",
      "profile": "reference"
    },
    {
      "match": "demos/**",
      "profile": "article"
    },
    {
      "match": "changes.md",
      "profile": "reference"
    }
  ]
}
