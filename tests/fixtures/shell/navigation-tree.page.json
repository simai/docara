{
  "schema": "docara.page.v1",
  "layout": {
    "regions": {
      "header": {"enabled": false},
      "sidebar": {
        "sections": [{
          "id": "navigation-tree",
          "section": "docara.shell",
          "blocks": [{
            "id": "navigation",
            "block": "shell.smart",
            "slot": "content",
            "smart": "docara.navigation",
            "view": "tree",
            "bind": "docara.navigation",
            "props": {"maximum_depth": 4}
          }]
        }]
      }
    }
  }
}
